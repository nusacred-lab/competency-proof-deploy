{
 admin off
 auto_https off
}
# Private identity backchannel only; never imported by the public ingress.
https://@@WALLET_AUTH_HOST@@:8443 {
    tls /tls/fullchain.pem /tls/privkey.pem
    header Cache-Control no-store
    reverse_proxy https://keycloak:8443 {
        header_up Host @@WALLET_AUTH_HOST@@
        transport http {
            tls_trust_pool file /tls/fullchain.pem
                tls_server_name @@WALLET_AUTH_HOST@@
        }
    }
}

https://@@ISSUER_AUTH_HOST@@:8443 {
    tls /tls/fullchain.pem /tls/privkey.pem
    header Cache-Control no-store
    reverse_proxy https://issuer-keycloak:8443 {
        header_up Host @@ISSUER_AUTH_HOST@@
        transport http {
            tls_trust_pool file /tls/fullchain.pem
                tls_server_name @@ISSUER_AUTH_HOST@@
        }
    }
}

https://@@EMPLOYER_AUTH_HOST@@:8443 {
    tls /tls/fullchain.pem /tls/privkey.pem
    header Cache-Control no-store
    reverse_proxy https://company-keycloak:8443 {
        header_up Host @@EMPLOYER_AUTH_HOST@@
        transport http {
            tls_trust_pool file /tls/fullchain.pem
                tls_server_name @@EMPLOYER_AUTH_HOST@@
        }
    }
}

http://:8025 {
 reverse_proxy mail:8025
}
